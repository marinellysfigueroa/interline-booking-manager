# Copia este archivo a .env (ignorado por git) antes de `docker compose up`.
# Son valores de DESARROLLO LOCAL: no reutilizar en ningún entorno real.

POSTGRES_DB=interline
POSTGRES_USER=interline
POSTGRES_PASSWORD=change-me-local-only

# Credenciales que esperan los stubs de WireMock (/wiremock/mappings/oauth2-token.json).
AMADEUS_CLIENT_ID=interline-dev
AMADEUS_CLIENT_SECRET=interline-dev-secret

# Dockerfile del backend: backend/Dockerfile (JVM) o backend/Dockerfile.native
BACKEND_DOCKERFILE=backend/Dockerfile

# OpenTelemetry: true = sin exportar trazas; false con el perfil "observability" (Jaeger)
OTEL_SDK_DISABLED=true

# Puertos publicados en el host
FRONTEND_PORT=4200
BACKEND_PORT=8080

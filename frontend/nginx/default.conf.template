# Plantilla procesada con envsubst al arrancar (solo ${PORT} y ${API_UPSTREAM}).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # --- Compresión -----------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/problem+json image/svg+xml application/xml;

    # --- Salud (para el HEALTHCHECK del contenedor) ----------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API: proxy al backend (mismo origen → sin CORS) ------------------------
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # Host del upstream (necesario si es una URL de Cloud Run) y SNI para HTTPS
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # --- Assets con hash en el nombre (main-AB12CD34.js): caché de un año ------
    location ~* "-[A-Za-z0-9_-]{8}\.(?:js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # --- Configuración white-label y resto de estáticos: siempre revalidar ------
    location /config/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # --- SPA: cualquier ruta del cliente devuelve index.html --------------------
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
